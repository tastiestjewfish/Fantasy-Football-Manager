{
  "name": "fantasy-football-manager",
  "private": true,
  "version": "1.0.0",
  "description": "League HQ fantasy football co-manager, plus a read-only league connector",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "node functions/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node apphosting-server.js",
    "start:api": "node functions/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
