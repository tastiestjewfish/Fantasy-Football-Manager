# Do not put FIREBASE_* keys in .env — Cloud Functions reserves that prefix.
# For local AI: create functions/.secret.local with:
#   ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_WORKSPACE_ID=wrkspc_...   # required for identity-linked keys
# For production: add a new version of secret ANTHROPIC_API_KEY in Secret Manager.
# Identity-linked keys also need ANTHROPIC_WORKSPACE_ID on the Cloud Function.

YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must match a Redirect URI on the Yahoo app exactly (no trailing slash).
YAHOO_REDIRECT_URI=https://fantasy-football-manager-210cc.web.app
ESPN_S2=
ESPN_SWID=
